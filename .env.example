# n8n on Vercel - Environment Configuration
# ==========================================
# Copy this file to .env and .env.local for development
# For production, configure these variables in your Vercel project settings

# Required Configuration
# --------------------

# Main application port (maps to Vercel PORT)
N8N_PORT=3000

# Vercel automatically sets PORT - this ensures n8n uses the correct port
# In Vercel: PORT=3000 (or whatever Vercel assigns)
# In local development: Set to match your local port mapping

# Public URL for webhooks and callbacks
# MUST be set to your production domain in production
WEBHOOK_URL=https://your-domain.vercel.app

# Database Configuration
# --------------------

# Toggle between SQLite (default) and Postgres
# Set to "true" to enable Postgres, "false" or unset for SQLite
USE_POSTGRES=false

# When USE_POSTGRES=true, the following variables are required:
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=your-supabase-host.supabase.co
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=postgres
DB_POSTGRESDB_USER=postgres
DB_POSTGRESDB_PASSWORD=your-supabase-password

# Optional n8n Settings
# --------------------

# Disable telemetry and usage reporting (recommended for privacy)
N8N_DIAGNOSTICS_ENABLED=false

# Relax file permission checks (needed for container environments)
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=false

# n8n Specific Configuration
# --------------------

# Basic Auth (optional - for production security)
# N8N_BASIC_AUTH_ACTIVE=true
# N8N_BASIC_AUTH_USER=username
# N8N_BASIC_AUTH_PASSWORD=password

# Encryption key for sensitive data (generate with: openssl rand -base64 32)
# N8N_ENCRYPTION_KEY=your-32-byte-base64-encoded-key

# Timezone
# N8N_TIMEZONE=America/New_York

# Memory limits
# N8N_MEMORY_LIMIT=1024

# Database Connection Pooling (Recommended for production)
#---------------------------------------------------
# Enable connection pooling for better Postgres performance
# DB_POSTGRESDB_POOL_MIN=2
# DB_POSTGRESDB_POOL_MAX=10
# DB_POSTGRESDB_POOL_IDLE_TIMEOUT=30000
# DB_POSTGRESDB_POOL_CONNECTION_TIMEOUT=5000

# Development Configuration
# --------------------

# For local development, you might want:
# N8N_PORT=3000
# WEBHOOK_URL=http://localhost:3000
# USE_POSTGRES=false  # Uses SQLite by default

# For local Postgres development:
# USE_POSTGRES=true
# DB_POSTGRESDB_HOST=localhost
# DB_POSTGRESDB_DATABASE=n8n_dev
# DB_POSTGRESDB_USER=n8n_user
# DB_POSTGRESDB_PASSWORD=dev_password

# Production Notes
# --------------------
# 1. In Vercel, configure all required environment variables in:
#    Project Settings > Environment Variables
# 
# 2. For Supabase:
#    - Create a new Postgres database
#    - Enable connection pooling
#    - Add your Vercel IP to Supabase's allowed IPs (or use "Allow all")
#    - Use the connection string format: postgres://user:password@host:port/database
#
# 3. For security in production:
#    - Always set WEBHOOK_URL to your production domain
#    - Enable Basic Auth or other authentication
#    - Set N8N_ENCRYPTION_KEY for sensitive workflow data
#    - Consider using a secrets manager for database credentials

# Local Development Quick Start
# --------------------
# 1. Copy this file to .env.local
# 2. Update WEBHOOK_URL to http://localhost:3000
# 3. Run: docker build -t n8n-vercel .
# 4. Run: docker run -p 3000:3000 --env-file .env.local n8n-vercel

# Troubleshooting
# --------------------
# If you get EMFILE errors, ensure graceful-fs is properly loaded
# If database connection fails, verify all Postgres variables are set
# If n8n doesn't start, check the container logs for errors