root = true

# Default settings for all files
[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 120

# Shell scripts
[*.sh]
indent_style = space
indent_size = 2

# Makefile
[Makefile]
indent_style = tab

# JSON files
[*.json]
indent_size = 2

# YAML files
[*.yml]
[*.yaml]
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false

# JavaScript files
[*.js]
indent_size = 2

# Dockerfile
[Dockerfile]
indent_style = space
indent_size = 2

# Git ignore files
[.gitignore]
[.gitmodules]
indent_style = space
indent_size = 1

# Editor settings
[*.{sublime-project,sublime-workspace}]
indent_style = space
indent_size = 2